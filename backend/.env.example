# Copiar a .env (no se versiona) y cambiar las claves.

# --- PostgreSQL ---
POSTGRES_USER=mastergrow
POSTGRES_PASSWORD=cambiar-db
POSTGRES_DB=mastergrow

# --- MQTT: usuarios del broker (usuario = node_id; las ACL usan %u) ---
MQTT_API_USER=api
MQTT_API_PASSWORD=cambiar-api
# Lista "usuario:clave" separada por comas para los nodos
MQTT_NODE_USERS=cam-01:cambiar-cam01,disp-01:cambiar-disp01

# --- API ---
APP_ENV=dev
MQTT_PORT=1883
# Ingestor MQTT (estado y eventos de los nodos → base). Identificador fijo = sesión persistente.
# MQTT_INGEST_ENABLED=true
# MQTT_CLIENT_ID=mastergrow-api

# Tokens HTTP (Contrato §5.1), "nombre:token" separados por coma. Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Token de cada nodo: va también en CONFIG_MG_API_TOKEN del firmware.
API_NODE_TOKENS=cam-01:cambiar-token-cam01
# Token de usuario: pantalla, app y navegador (galería: http://<host>:8000/gallery?token=...)
API_USER_TOKENS=pantalla:cambiar-token-pantalla,dev:cambiar-token-dev
