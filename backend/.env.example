# Copiar a .env (no se versiona) y cambiar las claves.

# --- PostgreSQL ---
POSTGRES_USER=mastergrow
POSTGRES_PASSWORD=cambiar-db
POSTGRES_DB=mastergrow

# --- MQTT: usuarios del broker (usuario = node_id; las ACL usan %u) ---
MQTT_API_USER=api
MQTT_API_PASSWORD=cambiar-api
# Lista "usuario:clave" separada por comas para los nodos
MQTT_NODE_USERS=cam-01:cambiar-cam01,disp-01:cambiar-disp01

# --- API ---
APP_ENV=dev
MQTT_PORT=1883
