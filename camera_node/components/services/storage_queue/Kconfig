menu "MasterGrow - Cola de almacenamiento (SD)"

    config MG_SQ_MAX_PENDING
        int "Máximo de capturas pendientes en la SD"
        default 2000
        range 10 20000
        help
            Al superarlo se borran primero las capturas rutinarias más antiguas
            (Arquitectura §5.2). El índice ocupa ~64 bytes de PSRAM por entrada.

    config MG_SQ_MIN_FREE_PCT
        int "Espacio libre mínimo a conservar (%)"
        default 10
        range 1 50
        help
            Si el espacio libre cae por debajo, se aplica la misma política de limpieza.

    config MG_SQ_FULL_EVENT_USED_PCT
        int "Uso de la SD que dispara el evento sd_full (%)"
        default 80
        range 50 99

endmenu
