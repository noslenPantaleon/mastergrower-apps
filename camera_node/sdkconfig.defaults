# ---- Placa: Seeed XIAO ESP32-S3 Sense (ESP32-S3R8: 8 MB flash, 8 MB PSRAM octal) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- PSRAM octal (framebuffers de cámara) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Bloques chicos en RAM interna (rápida); grandes a PSRAM. Reserva interna para DMA/WiFi.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- OTA con vuelta atrás: un firmware nuevo que no se conecta vuelve al anterior (mg_ota) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- Particiones: 2 slots OTA de 3 MB (OTA se implementa en fases posteriores) ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Consola por el USB nativo (USB-Serial-JTAG) ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- FreeRTOS / sistema ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- esp32-camera ----
# Tarea interna de la cámara en el núcleo 1 (captura y análisis, Arquitectura §3.2)
CONFIG_CAMERA_CORE1=y
# Solo los sensores que usamos (ahorra flash)
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=y
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n

# ---- FATFS (microSD): nombres largos para los ids de captura ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# ---- Red ----
CONFIG_LWIP_LOCAL_HOSTNAME="mastergrow-cam"

# ---- Hora: hasta 3 servidores NTP (mg_time) ----
CONFIG_LWIP_SNTP_MAX_SERVERS=3
