menu "MasterGrow - Nodo de cámara"

    config MG_NODE_ID
        string "node_id"
        default "cam-01"
        help
            Identificador único en el sistema (Contrato §3.1): cam-NN.

    config MG_FIRMWARE_VERSION
        string "Versión de firmware (se publica en status)"
        default "0.1.0"

    config MG_STATUS_PERIOD_S
        int "Período de republicación del status (s)"
        default 300
        range 30 3600
        help
            El status se publica al conectar y en cada cambio; además se refresca
            periódicamente (RSSI, espacio en SD).

    config MG_CAPTURE_RES
        string "Resolución de captura rutinaria"
        default "SVGA"
        help
            QVGA, VGA, SVGA, XGA, HD, SXGA, UXGA o QXGA. Luego la reemplaza la config remota.

    config MG_CAPTURE_RES_FULL
        string "Resolución completa (eventos, post-actuación, comandos)"
        default "UXGA"

    config MG_CAPTURE_INTERVAL_MIN
        int "Intervalo de captura rutinaria (min)"
        default 120
        range 1 1440
        help
            Contrato §7: capture_interval_min. Para probar, bajarlo a 1.

    config MG_LIGHT_WINDOW_START
        string "Inicio de la ventana de luz (HH:MM, hora local)"
        default "06:00"

    config MG_LIGHT_WINDOW_END
        string "Fin de la ventana de luz (HH:MM, hora local; 00:00 = medianoche)"
        default "00:00"

    config MG_UTC_OFFSET_MIN
        int "Diferencia de la hora local con UTC (min)"
        default -180
        range -720 840
        help
            Argentina: -180 (UTC-3). Se usa solo para evaluar la ventana de luz;
            todas las marcas de tiempo se publican en UTC.

    config MG_TRIGGER_MIN_INTERVAL_S
        int "Intervalo mínimo entre disparos (s), anti-duplicado"
        default 5
        range 0 3600

    config MG_CAPTURE_JPEG_QUALITY
        int "Calidad JPEG (0-63, menor es mejor)"
        default 12
        range 4 63

    config MG_SELFTEST_CAPTURES
        int "Capturas de autoprueba al arrancar (0 = desactivada)"
        default 10
        range 0 1000

    config MG_DEBUG_HTTP
        bool "Servidor HTTP de depuración (/capture.jpg, /status, /control)"
        default y
        help
            SOLO DESARROLLO: no tiene autenticación. Desactivar en producción.

    config MG_DEBUG_HTTP_PORT
        int "Puerto del servidor de depuración"
        default 80
        depends on MG_DEBUG_HTTP

endmenu
