{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastergrow.local/contract/mqtt/ctrl_state.schema.json",
  "title": "growlab/ctrl/{id}/state (PROVISIONAL)",
  "description": "Estado del módulo de control (Contrato §4.4, todavía abierto). Provisional: lo usan el simulador (backend/scripts/ctrl_sim.py) y la pantalla hasta que exista el módulo real. Los sensores que no aplican al modo de cultivo van en null.",
  "type": "object",
  "required": ["schema_version", "node_id", "ts", "node_state", "grow_mode", "sensors"],
  "properties": {
    "schema_version": { "const": 1 },
    "node_id": { "type": "string", "pattern": "^ctrl-[0-9]{2,}$" },
    "ts": { "type": "string", "format": "date-time" },
    "node_state": { "enum": ["booting", "operational", "autonomous", "error", "offline"] },
    "firmware": { "type": ["string", "null"] },
    "zone_id": { "type": ["string", "null"] },
    "grow_mode": { "enum": ["substrate", "coco_coir", "dwc"] },
    "sensors": {
      "type": "object",
      "properties": {
        "temperature": { "type": ["number", "null"], "description": "°C aire" },
        "humidity": { "type": ["number", "null"], "description": "% HR aire" },
        "co2": { "type": ["number", "null"], "description": "ppm" },
        "lux": { "type": ["number", "null"] },
        "substrate_moisture": { "type": ["number", "null"], "description": "% (sustrato y fibra de coco)" },
        "substrate_ec": { "type": ["number", "null"], "description": "mS/cm (sustrato y fibra de coco)" },
        "ph": { "type": ["number", "null"], "description": "DWC" },
        "ec": { "type": ["number", "null"], "description": "mS/cm solución (DWC)" },
        "dissolved_oxygen": { "type": ["number", "null"], "description": "mg/L (DWC)" },
        "water_temperature": { "type": ["number", "null"], "description": "°C solución (DWC)" },
        "reservoir_level": { "type": ["number", "null"], "description": "% del reservorio" }
      },
      "additionalProperties": true
    },
    "light": {
      "type": "object",
      "properties": {
        "on": { "type": "boolean" },
        "cycle": { "type": "string", "description": "horas luz/oscuridad, p. ej. 18/6" }
      }
    },
    "actuators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "mode"],
        "properties": {
          "id": { "type": "string", "description": "water_pump, air_pump, fan, light, …" },
          "state": { "enum": ["on", "off"] },
          "mode": { "enum": ["auto", "manual"] }
        }
      }
    }
  },
  "additionalProperties": true,
  "examples": [{
    "schema_version": 1, "node_id": "ctrl-01", "ts": "2026-11-23T14:30:00Z", "node_state": "operational",
    "firmware": "sim-0.1", "zone_id": "zone-a", "grow_mode": "substrate",
    "sensors": { "temperature": 24.6, "humidity": 61.2, "co2": 780, "lux": 18500,
                 "substrate_moisture": 42.0, "substrate_ec": 1.6, "ph": null, "ec": null,
                 "dissolved_oxygen": null, "water_temperature": null, "reservoir_level": 73 },
    "light": { "on": true, "cycle": "18/6" },
    "actuators": [ { "id": "water_pump", "state": "off", "mode": "auto" },
                   { "id": "fan", "state": "on", "mode": "auto" },
                   { "id": "light", "state": "on", "mode": "auto" } ]
  }]
}
