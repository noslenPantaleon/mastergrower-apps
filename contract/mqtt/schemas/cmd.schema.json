{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastergrow.local/contract/mqtt/cmd.schema.json",
  "title": "growlab/{kind}/{id}/cmd",
  "description": "node_id es el EMISOR del comando (p. ej. disp-01 o api).",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "ts",
    "action",
    "cmd_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "node_id": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "cmd_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "action": {
      "enum": [
        "capture_now",
        "refresh_config",
        "reboot",
        "start_stream",
        "stop_stream",
        "set_actuator",
        "set_mode"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "start_stream"
          }
        }
      },
      "then": {
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "type": "object",
            "required": [
              "session_id",
              "ws_publish_url",
              "resolution",
              "fps_max",
              "ttl_s"
            ],
            "properties": {
              "session_id": {
                "type": "string"
              },
              "ws_publish_url": {
                "type": "string",
                "description": "URL ws:// absoluta, o ruta (/api/v1/stream/{id}/publish) que el nodo resuelve contra su URL de la API"
              },
              "resolution": {
                "enum": [
                  "qvga",
                  "vga"
                ]
              },
              "fps_max": {
                "type": "integer",
                "minimum": 1
              },
              "ttl_s": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "stop_stream"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "session_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "refresh_config"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": 1,
      "node_id": "disp-01",
      "ts": "2026-11-09T18:45:00Z",
      "action": "capture_now",
      "cmd_id": "k-7f3a"
    }
  ]
}
