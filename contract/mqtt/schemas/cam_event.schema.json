{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastergrow.local/contract/mqtt/cam_event.schema.json",
  "title": "growlab/cam/{id}/event",
  "type": "object",
  "required": ["schema_version", "node_id", "ts", "event_type", "severity"],
  "properties": {
    "schema_version": { "const": 1 },
    "node_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "event_type": { "enum": ["early_lights_off", "plant_anomaly", "sd_full", "camera_error", "node_disconnected"] },
    "severity": { "enum": ["low", "medium", "high"] },
    "capture_id": { "type": ["string", "null"] },
    "detail": { "type": ["object", "string", "null"] }
  },
  "additionalProperties": true,
  "examples": [{
    "schema_version": 1, "node_id": "cam-01", "ts": "2026-11-09T18:42:10Z",
    "event_type": "early_lights_off", "severity": "high", "capture_id": "c-000123"
  }]
}
