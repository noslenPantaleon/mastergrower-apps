{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastergrow.local/contract/mqtt/cmd_ack.schema.json",
  "title": "growlab/{kind}/{id}/cmd/ack",
  "type": "object",
  "required": ["schema_version", "node_id", "ts", "cmd_id", "result"],
  "properties": {
    "schema_version": { "const": 1 },
    "node_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "cmd_id": { "type": "string" },
    "result": { "enum": ["accepted", "rejected", "done"] },
    "reason": { "type": ["string", "null"] }
  },
  "additionalProperties": true,
  "examples": [{ "schema_version": 1, "node_id": "cam-01", "ts": "2026-11-09T18:45:01Z", "cmd_id": "k-7f3a", "result": "accepted" }]
}
