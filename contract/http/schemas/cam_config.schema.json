{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastergrow.local/contract/http/cam_config.schema.json",
  "title": "Configuración efectiva de un nodo de cámara (GET /config/nodes/{id} → config)",
  "description": "Contrato §7. Cada parámetro: valor por defecto → global → override del nodo.",
  "type": "object",
  "properties": {
    "capture_interval_min": { "type": "integer", "minimum": 1, "maximum": 1440, "default": 120 },
    "light_window": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
      },
      "required": ["start", "end"],
      "additionalProperties": false,
      "default": { "start": "06:00", "end": "00:00" }
    },
    "utc_offset_min": { "type": "integer", "minimum": -720, "maximum": 840, "default": -180 },
    "analysis_mode": { "enum": ["hsv", "hybrid", "model"], "default": "hybrid" },
    "resolution": { "enum": ["QVGA", "VGA", "SVGA", "XGA", "HD", "SXGA", "UXGA", "QXGA"], "default": "SVGA" },
    "resolution_full": { "enum": ["QVGA", "VGA", "SVGA", "XGA", "HD", "SXGA", "UXGA", "QXGA"], "default": "UXGA" },
    "jpeg_quality": { "type": "integer", "minimum": 4, "maximum": 63, "default": 12 },
    "hsv_suspicion_threshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
    "min_trigger_interval_s": { "type": "integer", "minimum": 0, "maximum": 3600, "default": 5 },
    "stream_resolution_max": { "enum": ["qvga", "vga"], "default": "vga" },
    "stream_fps_max": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 },
    "stream_ttl_max_s": { "type": "integer", "minimum": 10, "maximum": 3600, "default": 600 }
  },
  "additionalProperties": true
}
