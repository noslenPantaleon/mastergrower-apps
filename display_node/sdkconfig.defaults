# ---- Placa: Waveshare ESP32-S3-Touch-LCD-4.3B (ESP32-S3-N16R8: 16 MB flash, 8 MB PSRAM octal) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- PSRAM octal: framebuffers del panel RGB 800×480 ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Código y constantes se ejecutan desde PSRAM: escribir la flash (NVS, OTA) no corta la caché y
# la imagen del panel no se desplaza (recomendado por Espressif para paneles RGB)
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
# Pilas de tareas en PSRAM (live, thumbs): solo para tareas que no escriben la flash
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---- Caché (como el ejemplo de Waveshare): el DMA del panel lee la PSRAM a través de ella ----
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- Panel RGB ----
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# ---- OTA con vuelta atrás: un firmware nuevo que no se conecta vuelve al anterior (mg_ota) ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- Particiones: 2 slots OTA de 6 MB ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Consola por el USB nativo (USB-Serial-JTAG) ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ---- FreeRTOS / sistema ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- LVGL 9 ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=15
# Memoria de LVGL en PSRAM (main/ui/lv_mem_psram.c): con la de la libc los pedidos chicos iban
# a la RAM interna y la agotaban (D5)
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
# Fuentes con tildes: Montserrat-Medium.ttf embebida y dibujada en tiempo de ejecución (D2)
CONFIG_LV_USE_TINY_TTF=y

# ---- Red ----
# Búferes de WiFi y lwIP en PSRAM: la RAM interna queda para DMA, el panel y LVGL. Sin esto, con
# la vista en vivo la RAM interna se agotaba ("wifi:m f null") y se caía la red (D5).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Pila TCP/IP en el núcleo 0 (red); el 1 es de LVGL
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_LOCAL_HOSTNAME="mastergrow-disp"
CONFIG_LWIP_SNTP_MAX_SERVERS=3
